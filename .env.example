GOOGLE_CREDENTIALS=x
GOOGLE_CALENDAR_ID=x

# Slack webhook for error notifications (optional)
SLACK_ERROR_WEBHOOK=x

# Cron schedule (default: 2 AM UTC daily)
CRON_SCHEDULE=0 2 * * *

# Persistent storage directory (mount as Docker volume for persistence across deploys)
# Default: /data
DATA_DIR=/data
